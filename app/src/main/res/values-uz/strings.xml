    <string name="distance_thresholds_title">Avtomatik kirish masofalari</string><string name="distance_thresholds_description">Yaqinlashganda avtomobil qaysi masofada ochilishi va uzoqlashganda qulflanishini tanlang.</string><string name="unlock_distance">Taxminan %1$s m da ochish</string><string name="lock_distance">Taxminan %1$s m da qulflash</string><string name="distance_approximate_warning">Masofalar taxminiy bo‘lib, 1 m va 5 m signal kalibrlashi asosida hisoblanadi. Devorlar, telefon holati va radio shovqin haqiqiy ishga tushish nuqtasini o‘zgartirishi mumkin.</string>
    <string name="calibration_title">Yaqinlikni kalibrlash</string><string name="calibration_description">Avtomobildan taxminan 1 metr masofada yaqin signalni saqlang. Keyin taxminan 5 metr uzoqlashib, uzoq signalni saqlang.</string><string name="current_signal">Joriy signal: %1$s</string><string name="capture_near">1 m da o‘lchash</string><string name="capture_far">5 m da o‘lchash</string><string name="captured_signal">Saqlandi: %1$s</string><string name="save_calibration">Kalibrlashni saqlash</string><string name="calibration_saved">Kalibrlash saqlandi</string><string name="error_calibration_save">Kalibrlashni saqlab bo‘lmadi. Qayta urinib ko‘ring.</string>
    <string name="safety_title">Xavfsizlik</string><string name="experimental_commands">Tajriba funksiyalari</string><string name="experimental_warning">Faqat avtomobil tasdiqlagan funksiyalar ko‘rinadi. Avtomobilni harakatlantirishi mumkin bo‘lgan amallar qurilma qulfini ochishni talab qiladi.</string>
